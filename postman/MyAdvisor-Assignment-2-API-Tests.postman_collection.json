        {
          "name": "Users API requires admin authentication",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Unauthenticated users API is rejected\", function () {",
                  "    pm.response.to.have.status(303);",
                  "    pm.expect(pm.response.headers.get(\"Location\") || \"\").to.include(\"/login\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authorization checks",
      "item": [
        {
          "name": "Student dashboard requires login",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "access_token="
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/app",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "app"
              ]
            },
            "description": "Redirect following is disabled so the authentication redirect can be tested.",
            "protocolProfileBehavior": {
              "disableFollowRedirects": true,
              "disableCookieJar": true
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.headers.remove(\"Cookie\");",
                  "pm.request.headers.remove(\"Authorization\");",
                  "pm.request.headers.upsert({ key: \"Cookie\", value: \"access_token=invalid-postman-token\" });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Unauthenticated access redirects\", function () {",
                  "    pm.response.to.have.status(303);",
                  "});",
                  "",
                  "pm.test(\"Redirect points to login\", function () {",
                  "    const location = pm.response.headers.get(\"Location\") || \"\";",
                  "    pm.expect(location, \"Expected a login redirect\").to.include(\"/login\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin dashboard requires authentication",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "access_token="
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin"
              ]
            },
            "description": "The request is expected to return the application's unauthorized response when no session cookie exists.",
            "protocolProfileBehavior": {
              "disableFollowRedirects": true,
              "disableCookieJar": true
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.headers.remove(\"Cookie\");",
                  "pm.request.headers.remove(\"Authorization\");",
                  "pm.request.headers.upsert({ key: \"Cookie\", value: \"access_token=invalid-postman-token\" });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Unauthenticated admin access is rejected\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
