{
  "info": {
    "_postman_id": "d4a4b4c7-3613-42a1-9c2a-myadvisor-a2",
    "name": "MyAdvisor Assignment 2 API Tests",
    "description": "Assignment 2 API and authorization tests for the MyAdvisor application.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "protocolProfileBehavior": {
    "disableFollowRedirects": true
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health and public endpoints",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.cookies.jar().clear(pm.request.url, function (error) {",
                  "    if (error) console.log(\"Could not clear cookies:\", error);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Health response is successful\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"ok\", true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Public landing page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.cookies.jar().clear(pm.request.url, function (error) {",
                  "    if (error) console.log(\"Could not clear cookies:\", error);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Landing page contains MyAdvisor\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"MyAdvisor\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Users API response shape",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.cookies.jar().clear(pm.request.url, function (error) {",
                  "    if (error) console.log(\"Could not clear cookies:\", error);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Users contain only the public response fields\", function () {",
                  "    pm.response.json().forEach(function (user) {",
                  "        pm.expect(user).to.have.all.keys(\"id\", \"username\", \"email\");",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authorization checks",
      "item": [
        {
          "name": "Student dashboard requires login",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "access_token="
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/app",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "app"
              ]
            },
            "description": "Redirect following is disabled so the authentication redirect can be tested.",
            "protocolProfileBehavior": {
              "disableFollowRedirects": true,
              "disableCookieJar": true
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.headers.remove(\"Cookie\");",
                  "pm.request.headers.remove(\"Authorization\");",
                  "pm.request.headers.upsert({ key: \"Cookie\", value: \"access_token=invalid-postman-token\" });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Unauthenticated access redirects\", function () {",
                  "    pm.response.to.have.status(303);",
                  "});",
                  "",
                  "pm.test(\"Redirect points to login\", function () {",
                  "    const location = pm.response.headers.get(\"Location\") || \"\";",
                  "    pm.expect(location, \"Expected a login redirect\").to.include(\"/login\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin dashboard requires authentication",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "access_token="
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin"
              ]
            },
            "description": "The request is expected to return the application's unauthorized response when no session cookie exists.",
            "protocolProfileBehavior": {
              "disableFollowRedirects": true,
              "disableCookieJar": true
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.headers.remove(\"Cookie\");",
                  "pm.request.headers.remove(\"Authorization\");",
                  "pm.request.headers.upsert({ key: \"Cookie\", value: \"access_token=invalid-postman-token\" });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Unauthenticated admin access is rejected\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication and role routing",
      "item": [
        {
          "name": "Admin login redirects to admin dashboard",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "admin",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "adminpass",
                  "type": "text"
                },
                {
                  "key": "next",
                  "value": "",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "protocolProfileBehavior": {
              "disableFollowRedirects": true
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.cookies.jar().clear(pm.request.url, function (error) {",
                  "    if (error) console.log(\"Could not clear cookies:\", error);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login succeeds\", function () {",
                  "    pm.response.to.have.status(303);",
                  "});",
                  "",
                  "pm.test(\"Admin is routed to admin dashboard\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/admin\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Student login redirects to student dashboard",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "student",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "studentpass",
                  "type": "text"
                },
                {
                  "key": "next",
                  "value": "",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "protocolProfileBehavior": {
              "disableFollowRedirects": true
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.cookies.jar().clear(pm.request.url, function (error) {",
                  "    if (error) console.log(\"Could not clear cookies:\", error);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login succeeds\", function () {",
                  "    pm.response.to.have.status(303);",
                  "});",
                  "",
                  "pm.test(\"Student is routed to student dashboard\", function () {",
                  "    const location = pm.response.headers.get(\"Location\") || \"\";",
                  "    pm.expect(decodeURIComponent(location)).to.include(\"/app\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
